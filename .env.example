# FAV Digital — variáveis de configuração (placeholders). NUNCA coloque credenciais reais neste arquivo.
# Perfil: development | test | homologacao | producao  (homologacao/producao recusam provedor simulado)
FAV_PROFILE=development
PORT=8080
# Banco (papel de execução fav_app). Em homologação prefira DATABASE_URL_FILE (segredo montado).
DATABASE_URL=postgres://fav_app:TROCAR@localhost:5432/fav
# DATABASE_URL_FILE=/etc/fav/db/database-url
# Migrações (papel fav_migrator) — usado apenas pelo comando migrate
MIGRATION_DATABASE_URL=postgres://fav_migrator:TROCAR@localhost:5432/fav
# Sessão
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
DIRECTORY_STALENESS_HOURS=26
TRUST_PROXY=false
# Identidade: simulated (dev/test) | kerberos-ldap (homologação)
AUTH_PROVIDER=simulated
KRB5_REALM=EXEMPLO.INVALID
KRB5_CONFIG=/etc/fav/krb5/krb5.conf
KRB5_CCACHE_DIR=/tmp/fav-krb
LDAP_URI=ldap://dc.exemplo.invalid:389
LDAP_BASE_DN=DC=exemplo,DC=invalid
LDAP_SASL_MINSSF=128
LDAP_IMPORT_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_ELIGIBLE_GROUP_DN=
LDAP_ATTR_FUNCTIONAL_ID=sAMAccountName
LDAP_ATTR_UNIT=department
LDAP_ATTR_TITLE=title
AUTH_TIMEOUT_MS=8000
# Sincronização (identidade técnica de leitura; keytab montado)
SYNC_PRINCIPAL=
SYNC_KEYTAB_FILE=/etc/fav/keytab/sync.keytab
SYNC_INTERVAL_MINUTES=60
SYNC_ANOMALY_RATIO=0.5
# Limites de login
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
