{
  "name": "@fav/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:setup": "node dist-test/src/db/cli.js setup",
    "migrate": "node dist/db/cli.js migrate",
    "seed": "node dist/db/cli.js seed",
    "sync": "node dist/db/cli.js sync",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../.env dist/main.js",
    "test": "rm -rf dist-test && tsc -p tsconfig.json && node --test --test-concurrency=1 'dist-test/test/**/*.test.js'"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
