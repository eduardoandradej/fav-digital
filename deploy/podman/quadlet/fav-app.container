[Unit]
Description=FAV Digital — aplicação (API + frontend)
Requires=fav-migrate.service
After=fav-migrate.service

[Container]
ContainerName=fav-app
Image=localhost/fav-digital:local
Network=fav.network
PublishPort=127.0.0.1:8080:8080
ReadOnly=true
Tmpfs=/tmp:rw,size=64m,mode=1777
DropCapability=ALL
NoNewPrivileges=true
EnvironmentFile=%h/.config/fav-digital/app.env
# printf '%s' 'postgres://fav_app:SENHA@fav-db:5432/fav' | podman secret create fav-database-url -
Secret=fav-database-url,type=env,target=DATABASE_URL
HealthCmd=node -e "fetch('http://127.0.0.1:8080/api/v1/saude/vivo').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=30s

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
